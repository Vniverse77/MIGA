# /etc/miga/relay.env  (owner root, mode 0640, group miga). Copy the real values of MIGA_ORIGINS
# from the running relay; nothing in this file is a secret.
MIGA_ADDR=127.0.0.1:8787
MIGA_DB=/var/lib/miga/miga.db
MIGA_BLOBS=/var/lib/miga/blobs
MIGA_STATIC=/srv/miga/web
MIGA_ORIGINS=tauri://localhost,http://tauri.localhost
MIGA_TRUST_PROXY=1

# Optional limits (defaults shown; see docs/OPS.md)
#MIGA_MAX_CONNS_PER_IP=300
#MIGA_CONNS_PER_MIN=600
#MIGA_MSGS_PER_MIN=3000
#MIGA_NEW_RCPT_PER_HOUR=300
#MIGA_QUEUE_MSGS=1000
#MIGA_QUEUE_BYTES=8388608
#MIGA_QUEUE_TOTAL_BYTES=536870912
#MIGA_BLOB_QUOTA=1073741824
#MIGA_BLOB_UPLOADS_TOTAL=16
#MIGA_BLOB_UPLOADS_PER_IP=20
#MIGA_BLOB_DOWNLOADS_PER_IP=60
#MIGA_BLOB_UPLOADS_PER_10MIN=300
